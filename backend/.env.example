# AGRAPATHA Backend Gateway Configuration (Template — isi nilai asli di .env lokal / hosting)
PORT=3000
NODE_ENV=development

# EMQX Cloud Serverless MQTT Broker (TLS / Port 8883)
MQTT_HOST=your-broker-host.emqxsl.com
MQTT_PORT=8883
MQTT_TLS_PORT=8883
MQTT_WS_PORT=8084
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_BROKER_URL=mqtts://your-broker-host.emqxsl.com:8883

# Operator and Security Secrets
GATEWAY_TOKEN_SECRET=change_me_to_long_random_secret_32chars_minimum
OPERATOR_ACCOUNTS_JSON=[]
ENABLE_ACTUATOR_COMMANDS=true
